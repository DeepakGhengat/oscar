{
  "name": "oscar",
  "version": "0.1.0",
  "type": "module",
  "description": "O.S.C.A.R. — Orchestrator for System Coding & Autonomous Routing. Runs your coding CLI against any OpenAI-compatible backend.",
  "keywords": [
    "coding-agent",
    "ollama",
    "openai",
    "llm",
    "proxy",
    "local-llm",
    "deepseek",
    "lm-studio",
    "vllm"
  ],
  "license": "MIT",
  "bin": {
    "oscar": "bin/oscar.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "scripts/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "node --watch --import tsx src/server.ts",
    "setup": "tsx src/setup.ts",
    "doctor": "tsx src/doctor.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
